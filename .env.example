# Copy this file to .env and fill in what you have. NEVER commit .env.
# Anything left empty switches that feature to an offline fallback, so the app always runs.

# ---------- AI (Claude) ----------
# From console.anthropic.com -> API keys. Empty = offline keyword rules + scripted agents.
ANTHROPIC_API_KEY=
# Optional: which model and how hard it thinks (low = fastest replies for a live demo)
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# ---------- PayPal sandbox ----------
# developer.paypal.com -> Apps & Credentials (Sandbox) -> your app. Empty = mock checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=GBP
# marketplace = buyer pays RigAgent once; shops paid by Payouts; used parts held in escrow
# split       = one order, one purchase unit per seller, paid directly by PayPal
PAYPAL_CHECKOUT_MODE=marketplace
# Where PayPal sends the buyer back. Locally: http://localhost:8501  On Render: your app URL
APP_BASE_URL=http://localhost:8501
# Webhooks (only when deployed - PayPal can't reach localhost). In your PayPal app, add a
# webhook for <APP_BASE_URL>/paypal/webhook with "All events", then paste its Webhook ID here.
PAYPAL_WEBHOOK_ID=

# Sandbox BUSINESS account emails for the seed sellers (Testing Tools -> Sandbox Accounts).
# The number is the SellerID in seed.sql. Rebuild the DB (python db.py) after changing these.
SELLER_1_EMAIL=
SELLER_2_EMAIL=
SELLER_3_EMAIL=
SELLER_4_EMAIL=
SELLER_5_EMAIL=

# ---------- Part prices ----------
CHANNEL3_API_KEY=
# eBay developer keys (production keyset): App ID and Cert ID
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# ---------- Optional ----------
# RIGAGENT_DB=pcparts.db          # database file location
# RIGAGENT_OFFLINE_AI=true        # force offline AI even with a key (saves credits while testing)
